# Local synthetic environment only. Replace APP_KEY using the setup guide.
APP_NAME="Fokus Law Synthetic"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081
MAIL_MAILER=array
LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Optional first synthetic administrator identity. Set the real local recipient
# only in ignored docker.env, never in this tracked example.
FOKUS_ADMIN_BOOTSTRAP_NAME=
FOKUS_ADMIN_BOOTSTRAP_EMAIL=

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=fokus_law_synthetic
DB_USERNAME=fokus_law_local
DB_PASSWORD=local-only-change-me
MYSQL_DATABASE=fokus_law_synthetic
MYSQL_USER=fokus_law_local
MYSQL_PASSWORD=local-only-change-me
MYSQL_ROOT_PASSWORD=local-root-only-change-me
